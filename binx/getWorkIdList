#!/usr/bin/env python3
"""Read work IDs directly from the JRP Works spreadsheet, in row order."""
import argparse
import csv
import io
import json
from pathlib import Path
import re
import subprocess
import sys

URL = ('https://docs.google.com/spreadsheets/d/'
       '11apuRwRGCNVdyErVqoUs_-ljfiokjdqiS-AEcMVTTqU/export?format=csv&gid=0')


def work_ids(raw):
    text = raw.decode('utf-8-sig')
    # Preserve compatibility with the old --input works.json option.
    if text.lstrip().startswith('['):
        rows = json.loads(text)
        if not isinstance(rows, list) or any(not isinstance(row, dict) for row in rows):
            raise ValueError('Works input must be an array of objects')
        ids = [row.get('WORK_ID', '') for row in rows]
    else:
        csv.field_size_limit(16 * 1024 * 1024)
        rows = list(csv.reader(io.StringIO(text, newline=''), strict=True))
        if not rows or not rows[0] or rows[0][0] != 'WORK_ID':
            raise ValueError('Works CSV is missing the WORK_ID header; check spreadsheet read access')
        while len(rows) > 1 and not any(rows[-1]):
            rows.pop()
        ids = [row[0] if row else '' for row in rows[1:]]
    for work_id in ids:
        if not isinstance(work_id, str) or (work_id and not re.fullmatch(
                r'[A-Z][a-z]{2}\d{4}[A-Za-z0-9]*(?:\.[A-Za-z0-9]+)*', work_id)):
            raise ValueError('Invalid WORK_ID in Works input')
    if not any(ids):
        raise ValueError('Works input contains no work IDs')
    return ids


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--input', type=Path, help='Read a local Works CSV or JSON file')
    args = parser.parse_args()
    if args.input:
        raw = args.input.read_bytes()
    else:
        response = subprocess.run(
            ['curl', '--fail', '--silent', '--show-error', '--location',
             '--connect-timeout', '15', '--max-time', '90',
             '--header', 'Cache-Control: no-cache', URL], capture_output=True)
        if response.returncode:
            raise ValueError('Works download failed; no IDs generated. ' +
                             response.stderr.decode('utf-8', errors='replace').strip())
        raw = response.stdout
    # Validate everything before emitting any IDs; make replaces the list atomically.
    print('\n'.join(work_ids(raw)))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError, csv.Error) as error:
        print(f'Work ID extraction failed: {error}', file=sys.stderr)
        sys.exit(1)
